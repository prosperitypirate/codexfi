# Copy this file to .env and fill in your keys
# cp .env.example .env
#
# codexfi needs no API keys: extraction runs through your Claude Code login and
# embeddings run on-device.

# Optional: Anthropic API key — only for llmBackend "anthropic-api"
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
