{
	"name": "codexfi",
	"version": "0.7.6",
	"description": "Persistent, searchable memory for Claude Code \u2014 automatic extraction, local embeddings, no API keys",
	"type": "module",
	"main": "dist/codexfi.js",
	"bin": {
		"codexfi": "./dist/codexfi.js"
	},
	"scripts": {
		"build": "bun build src/cli/index.ts --outfile dist/codexfi.js --target node --external @huggingface/transformers",
		"typecheck": "tsc --noEmit",
		"cli": "bun run src/cli/index.ts"
	},
	"dependencies": {
		"@huggingface/transformers": "4.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "6.0.3"
	},
	"keywords": [
		"claude-code",
		"claude-code-plugin",
		"memory",
		"ai",
		"coding-agent",
		"persistent-memory",
		"mcp"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/prosperitypirate/codexfi.git",
		"directory": "plugin"
	},
	"homepage": "https://codexfi.com",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist"
	]
}
